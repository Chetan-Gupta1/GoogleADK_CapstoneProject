  "content": {
    "slide_1": {
      "title": "NovaRetail Q2 2026 Performance and Regional QBR Overview",
      "summary": "Total revenue reached $1,280M in 2026-Q2 with 4.5% QoQ growth across all operating regions. Strong growth in APAC, where revenue expanded 26.9% to $330M, highlights significant expansion opportunities. However, severe operational strain in Latin America represents our biggest risk, with stockouts rising 3.5 percentage points to 12.5% and NPS falling 9 points to 29.",
      "icon": "globe_region.png"
    },
    "slide_2": {
      "title": "Regional Revenue Performance and Portfolio Expansion Trends",
      "insights": [
        "Lead top-line growth in North America, increasing sales by $45M from 2025-Q3 to reach $465M.",
        "Accelerate APAC revenue expansion by 26.9% to $330M with 860K unit sales in 2026-Q2.",
        "Deliver steady European growth, expanding top-line revenue by 11.3% to $345M across quarters.",
        "Address Latin America revenue contraction of 6.7% to $140M as unit volume fell to 390K."
      ],
      "icon": "growth_chart.png"
    },
    "slide_3": {
      "title": "Regional Customer Experience and Satisfaction Trajectories",
      "insights": [
        "Champion customer satisfaction in APAC, achieving a 62 NPS and 92% CSAT to lift overall metrics.",
        "Enhance European customer experience, raising NPS by 5 points to 53 while cutting delivery to 3.2 days.",
        "Improve North America satisfaction, boosting NPS by 3 points to 55 while stabilizing ticket volume.",
        "Reverse Latin America customer friction, tackling a 9-point NPS drop to 29 caused by 7.5-day delivery delays."
      ],
      "icon": "customer_star.png"
    },
    "slide_4": {
      "title": "Operational Risk Factors Across Logistics and Security",
      "insights": [
        "Mitigate Latin America supply bottlenecks to curb rising stockout rates that reached 12.5%.",
        "Confront Latin America security risks, responding to fraud cases jumping from 18 to 30 incidents.",
        "Relieve APAC warehouse strain as 92% capacity utilization drove stockout rates up to 8.5%.",
        "Shorten Latin America return processing timelines after delays extended turnaround to 10 days."
      ],
      "icon": "risk_alert.png"
    },
    "slide_5": {
      "title": "Strategic Recommendations for Operational Optimization",
      "recommendations": [
        "Expand APAC warehouse capacity to resolve 92% utilization and lower stockout rates from 8.5%.",
        "Deploy robust fraud prevention controls in Latin America to counter the 30 reported security incidents.",
        "Overhaul Latin America logistics to reduce 7.5-day delivery times and reverse the 9-point NPS drop.",
        "Streamline global return processing workflows to reduce turnaround delays across high-volume hubs."
      ],
      "closing": "Targeted operational investments will stabilize high-risk regions while supporting sustainable growth across global markets.",
      "icon": "lightbulb_action.png"
    }
  }
