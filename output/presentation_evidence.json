    "slide_2": {
      "title": "Revenue Expansion Led by APAC and North America",
      "insights": [
        "Total revenue reached 1280.0 million USD in 2026-Q2, growing 4.49 percent QoQ from the previous quarter.",
        "APAC revenue grew by 26.92 percent from 2025-Q3 to 2026-Q2, reaching 330.0 million USD.",
        "North America remains the top revenue contributor, increasing by 45.0 million USD to 465.0 million USD.",
        "Latin America revenue declined by 6.67 percent, falling from 150.0 million USD to 140.0 million USD."
      ],
      "icon": "growth_chart.png"
    },
    "slide_3": {
      "title": "Customer Experience Diverges Across Key Regions",
      "insights": [
        "Mean regional NPS stands at 49.75 points, with APAC leading at 62.0 points in 2026-Q2.",
        "Latin America NPS fell by 9.0 points to 29.0 points, while CSAT decreased by 6.0 percentage points.",
        "Europe improved customer satisfaction, raising NPS by 5.0 points and CSAT by 2.0 percentage points.",
        "North America customer metrics improved slightly, with NPS rising by 3.0 points to 55.0 points."
      ],
      "icon": "customer_star.png"
    },
    "slide_4": {
      "title": "Operational Risks and Supply Chain Constraints Intensify",
      "insights": [
        "Latin America delivery times increased by 2.0 days, while support tickets surged by 11.0K.",
        "Fraud incidents in Latin America rose from 18 to 30, representing a significant security risk.",
        "APAC warehouse capacity utilization reached 92.0 percent, while stockout rates increased by 2.5 percentage points.",
        "Returns rate in Latin America increased by 1.7 percentage points, reaching 8.2 percent in 2026-Q2."
      ],
      "icon": "risk_alert.png"
    },
    "slide_5": {
      "title": "Recommended Actions to Address Operational Bottlenecks",
      "recommendations": [
        "Expand warehouse capacity in APAC to address the 92.0 percent utilization rate and rising stockouts.",
        "Implement fraud prevention measures in Latin America to address the rise to 30 fraud incidents.",
        "Optimize Latin America logistics to reduce delivery times, which increased by 2.0 days since 2025-Q3.",
        "Streamline return processing in APAC to reduce processing times, which rose by 1.0 days."
      ],
      "closing": "Addressing these operational challenges will help stabilize Latin America and sustain APAC growth.",
